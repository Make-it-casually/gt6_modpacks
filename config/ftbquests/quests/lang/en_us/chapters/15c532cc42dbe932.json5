{
  "quest.68C5F0F723D0EB00.quest_subtitle": "Get more precious metals from ores",
  "quest.7B8C9C297BC5033A.quest_subtitle": "Complete either one to progress",
  "quest.69C4C65DF1AC560D.quest_desc": [
    "Treating Purified Ore with Sulfuric Acid in the Bath converts it into Refined Ore with a 50% yield bonus. The extra byproducts obtained in the original Centrifuge processing step are replaced with Hydrogen and a specific sulfate solution.",
    "",
    "Not all ores support this sulfuric acid ore washing branch.",
  ],
  "quest.7AB87161BDCC02A8.title": "Tip",
  "quest.156C13E8839DC9D0.quest_subtitle": "Much simpler than GTNH",
  "quest.132DDBC8BCD2F848.quest_desc": [
    "Electrolyze Tantalite.",
  ],
  "quest.63E6B1D806CEF401.title": "Hydrochloric Acid",
  "quest.7ECCDB6F9E22F252.quest_desc": [
    "To mass-produce Aluminium, you must find an excellent source of aluminium raw material.",
    "",
    "Bauxite is a great choice.",
  ],
  "quest.42F9BD1CC0337F62.quest_desc": [
    "Mix Sulfuric Acid with Niter Dust (Sodium Nitrate or Potassium Nitrate also works) in the Mixer to produce Nitric Acid. Producing Nitric Acid by reacting Nitrogen Dioxide with Water also works.",
    "",
    "Nitric Acid is also acidic, so remember to store it in acid-proof tanks.",
  ],
  "quest.704623ECFBDD966E.title": "Mixer",
  "quest.63E6B1D806CEF401.quest_subtitle": "Why is gaseous Hydrogen Chloride called Hydrochloric Acid?",
  "quest.608EDDB70A449823.quest_desc": [
    "Feed the sulfate solution obtained in the aforementioned sulfuric acid ore washing step, together with Water, into the Electrolyzer and supply at least 64EU/t of power to decompose the sulfate solution into Sulfuric Acid, the corresponding anion dust and Oxygen.",
    "",
    "In this cycle, Sulfuric Acid is recycled without loss and can be fed back into the Bath to continue washing other ores.",
    "",
    "Note: electrolyzing Vitriol of Clay (Aluminium Sulfate) does not produce elemental Aluminium; instead it absorbs the Oxygen produced by the reaction and joins the later bauxite refining process in the form of Alumina.",
  ],
  "quest.678A8A51BBABD764.quest_desc": [
    "Electrolyze Salt and Water; byproducts are Chlorine, Hydrogen and Oxygen.",
  ],
  "quest.57BA9263734ED6D8.quest_desc": [
    "Put Rutile Dust or Ilmenite together with Carbon Dust and Chlorine into the Burner Mixer to obtain it.",
    "",
    "The Carbon Dust here can be Charcoal Dust, Coal Dust, Coal Coke Dust, Carbon Dust or Petroleum Coke Dust.",
    "",
    "The Burner Mixer needs to be ignited, and if the recipe run is interrupted it must be re-ignited.",
    "",
    "Because in the titanium line the Burner Mixer runs much faster than the Electrolyzer recovers Chlorine and Magnesium, you need to use an Automatic Igniter together with Redstone to ignite it automatically.",
  ],
  "quest.5358FEEF18B1FF07.quest_desc": [
    "Cryolite is one of the indispensable fluxes for aluminium smelting, but unfortunately there are no natural Cryolite deposits in Greg's world. Use Sodium Hydroxide, Alumina and Hydrogen Fluoride to make a batch of Molten Cryolite.",
  ],
  "quest.42F9BD1CC0337F62.quest_subtitle": "The third of the three industrial acids",
  "quest.4B4912D5F8E28656.quest_desc": [
    "Dry Tungstic Acid Dust.",
  ],
  "quest.68C5F0F723D0EB00.quest_desc": [
    "Washing platinum-bearing ores (Purified Nickel/Platinum/Sperrylite... etc.) with Aqua Regia extracts Chloroplatinic Acid; some platinum group elements that do not dissolve in Aqua Regia are also produced as Platinum Group Sludge, to be refined in the next step.",
    "",
    "Aqua regia washing can also produce Chloroauric Acid and Stannic Chloride, which we will not cover here.",
  ],
  "quest.154B691FED77B58A.quest_desc": [
    "Mix Sulfuric Acid with Fluorite Dust (any color) in the Mixer to produce Hydrogen Fluoride.",
    "",
    "Unfortunately, elemental Fluorine, unlike its group relative Chlorine, cannot react directly with Water to give Hydrogen Fluoride and Oxygen; it can only react with Hydrogen.",
    "",
    "Hydrogen Fluoride is also acidic, so remember to store it in acid-proof tanks.",
  ],
  "quest.75F4E89D9560C01A.title": "Warning: Strongly Acidic Substances",
  "quest.68C5F0F723D0EB00.title": "Aqua Regia Washing: Platinum Group Elements",
  "quest.33C66CE7CBBDEFF9.title": "Elemental Chlorine",
  "quest.5358FEEF18B1FF07.title": "Synthetic Cryolite",
  "quest.7ECCDB6F9E22F252.title": "Finding Bauxite",
  "quest.19A50FC13211C8FC.quest_desc": [
    "Mix Hexafluorosilicic Acid with Alumina Dust to obtain Molten Aluminium Fluoride.",
    "",
    "Aluminium Fluoride is one of the indispensable fluxes for aluminium smelting.",
  ],
  "quest.27FDD460B28DCE49.quest_desc": [
    "Reduce Potassium Heptafluorotantalate with Molten Sodium; the resulting Potassium Fluoride can be recycled on its own, and the Sodium Fluoride can be recycled after electrolysis.",
  ],
  "quest.47EF318E651D65DE.title": "Aqua Regia",
  "quest.3998AC0B49AB0EE0.quest_desc": [
    "Wash Molten Magnesium Carbonate with Salt in the Bath.",
    "",
    "Magnesium Carbonate is Magnesite.",
  ],
  "quest.75F4E89D9560C01A.quest_desc": [
    "Some fluids in GT6 are acidic. They corrode any fluid container that is not acid-proof, causing unnecessary losses.",
    "",
    "If you need to safely store/transport acidic fluids, use acid-proof containers.",
    "",
    "Craft one (or more) Stainless Steel Drums to support your chemical industry.",
    "",
    "Note: The fluid input/output slots of all processing machines are acid-proof by themselves.",
    "",
    "Note: Crucibles are also corroded by acids; before processing acidic substances, verify that the Crucible you use is acid-proof.",
  ],
  "quest.1D1A4F2D73D66D9E.quest_desc": [
    "An automated Bathing Pot that works very slowly.",
    "",
    "It has 3 fluid output slots instead of 1.",
  ],
  "quest.704623ECFBDD966E.quest_subtitle": "An automated mixing bowl",
  "quest.79240EA4A02DE5F7.quest_desc": [
    "Electrolyzing Chloroplatinic Acid in the Electrolyzer extracts Platinum Dust and recovers all the Hydrochloric Acid consumed by aqua regia washing.",
    "",
    "The Oxygen byproduced by this process can be used to recover Nitric Acid, but this is a lossy cycle; you must periodically replenish Oxygen from outside.",
  ],
  "quest.7A60EACBC8E86A1A.quest_desc": [
    "Processing Molten Sodium Carbonate in a Burner Mixer, or electrolyzing Sodium Hydroxide, can provide the small amount of Sodium needed to start the tantalum line.",
  ],
  "quest.0EDAA054881C8AAE.quest_desc": [
    "Processing Ilmenite Dust is a bit more troublesome than Rutile Dust; you can skip it at first.",
    "",
    "Although Ilmenite Dust can be thrown directly into the Burner Mixer, the Ferric Chloride it produces is hard to deal with.",
    "",
    "The recommended approach is to convert it into Rutile Dust with Sulfuric Acid in the Bath; the resulting Green Vitriol (Ferrous Sulfate) can be electrolyzed directly to recover Sulfuric Acid.",
  ],
  "quest.7A03772380A5FFB7.quest_desc": [
    "Wash Huebnerite Dust, Wolframite Dust, Scheelite Dust, Tungstate Dust or Ferberite Dust with Hydrochloric Acid in the Bath.",
    "",
    "Electrolyzing the byproducts to recover Chlorine is a good idea.",
  ],
  "quest.154B691FED77B58A.title": "Hydrogen Fluoride",
  "quest.33C66CE7CBBDEFF9.quest_desc": [
    "Wash Pyrolusite with Hydrochloric Acid; the redox reaction between them produces Manganese Chloride and Chlorine.",
    "",
    "If you already have an Electrolyzer, electrolyzing [Magnesium/Manganese/Calcium/Ferrous] Chloride to obtain Chlorine is also a good idea.",
    "",
    "&oElectrolyzing Salt, Rock Salt or Lithium Chloride is not recommended; their processing times are extremely long.",
  ],
  "quest.42F9BD1CC0337F62.title": "Nitric Acid",
  "quest.07E3853C78FB0934.quest_desc": [
    "Mix Tungsten Trioxide Dust with Hydrogen.",
    "",
    "This step consumes a large amount of Hydrogen; if you don't have enough, you can wash Bauxite with Sulfuric Acid.",
  ],
  "quest.33C66CE7CBBDEFF9.quest_subtitle": "Laboratory Chlorine Production",
  "quest.1351EEBDE8EADFFF.quest_desc": [
    "Electrolyze Magnesium Chloride to obtain Magnesium Dust.",
    "",
    "This recipe requires 64GU/t of power.",
    "",
    "If you process it into Molten Magnesium Chloride with a Smelter and then electrolyze it, only 16GU/t of power and half the energy are needed.",
    "Sounds great, but in fact a full-speed LV Electrolyzer running the Molten Magnesium Chloride recipe takes twice as long as a full-speed MV Electrolyzer running the Magnesium Chloride recipe.",
    "If you run the Molten Magnesium Chloride recipe in an MV Electrolyzer, the lossy overclocking means the actual time and energy consumption are no different from the Magnesium Chloride recipe.",
    "Therefore, the Molten Magnesium Chloride recipe is only practically meaningful once you have a Large Electrolyzer capable of lossless overclocking.",
  ],
  "quest.4D045217201E8E74.title": "Autoclave",
  "quest.704623ECFBDD966E.quest_desc": [
    "Lined with Stainless Steel and airtight, it allows multiple fluids to be mixed and also allows corrosive fluids to undergo chemical reactions inside it.",
    "",
    "&cDo not try to feed gases or corrosive fluids into the mixing bowl!",
  ],
  "quest.7BE866156945A526.title": "Obtaining Alumina",
  "quest.07E5E0F1D01D87BB.quest_desc": [
    "Mix Hydrogen Fluoride with Potassium Carbonate.",
  ],
  "quest.741C6D1E92C92B3F.quest_desc": [
    "Reduce Titanium Tetrachloride with Magnesium in the Bath.",
    "",
    "Obtaining Titanium Dust is not the end of the titanium line; you also need to build a Magnesium Chloride recovery line to close the loop.",
    "Otherwise your Chlorine and Magnesium will run out sooner or later.",
    "",
    "As for why Sodium is not used for the reduction: one Sodium can only reduce one, and Salt is very hard to recover.",
  ],
  "quest.154B691FED77B58A.quest_subtitle": "Beware the Temptation to Make Fluorine",
  "quest.23A67D579CF203EB.quest_desc": [
    "Pour the previously prepared Molten Aluminium Fluoride and Molten Cryolite into the Electrolyzer and electrolyze them together with Carbon Dust (Charcoal, Coal Coke and similar substitutes also work) and Alumina Dust to obtain shiny elemental Aluminium.",
    "",
    "Every two Aluminium Dust need only 2mB of Aluminium Fluoride and 1mB of Cryolite; you only need to produce small amounts of them, no passive production line required.",
  ],
  "quest.79240EA4A02DE5F7.title": "Electrolyzing Chloroplatinic Acid",
  "quest.4435AF044318E1D5.quest_desc": [
    "Washing [Sodium/Potassium] Aluminate with Water in the Bath releases the [Sodium/Potassium] Hydroxide added earlier and produces Aluminium Hydroxide Dust.",
  ],
  "quest.7B8C9C297BC5033A.title": "Placeholder Quest",
  "quest.60BEB5E567CD1F5F.quest_desc": [
    "Titanium processing has two starting points: Rutile Dust and Ilmenite Dust.",
    "",
    "Rutile needs to be processed into Titanium Tetrachloride in the Burner Mixer.",
    "",
    "Note that Titanium Tetrachloride is corrosive; Stainless Steel or Vanadiumsteel pipes are recommended.",
    "",
    "Ilmenite processing is more troublesome, so you can skip ilmenite processing at first.",
  ],
  "quest.608EDDB70A449823.title": "Electrolyzing Sulfate",
  "quest.63E6B1D806CEF401.quest_desc": [
    "Mix Sulfuric Acid with [Salt/Rock Salt] Dust in the Mixer to produce Hydrochloric Acid. If you have elemental Chlorine, you can also mix Chlorine with Water to obtain Hydrochloric Acid directly.",
    "",
    "Hydrochloric Acid is also acidic, so remember to store it in acid-proof tanks.",
  ],
  "quest.57BA9263734ED6D8.title": "Titanium Tetrachloride",
  "quest.47EF318E651D65DE.quest_desc": [
    "Mix Hydrochloric Acid and Nitric Acid to obtain Aqua Regia.",
    "",
    "Extremely oxidizing; it can even dissolve metals that are hard to oxidize, such as Gold and Platinum.",
  ],
  "quest.708E111BC336F1C9.quest_desc": [
    "Use a Dryer to dry Aluminium Hydroxide and dehydrate it into Alumina.",
    "",
    "Smelting it in a Crucible also works; the ratio is 14 Aluminium Hydroxide → 5 Alumina for both, so don't be fooled by JEI.",
  ],
  "quest.47EF318E651D65DE.quest_subtitle": "Contains no Dilute Sulfuric Acid",
  "quest.4435AF044318E1D5.title": "Aluminium Hydroxide Precipitation",
  "quest.4D045217201E8E74.quest_desc": [
    "React Bauxite Dust and [Sodium/Potassium] Hydroxide Dust under high-pressure steam to obtain [Sodium/Potassium] Aluminate Dust, along with some Ilmenite and Rutile as byproducts.",
    "",
    "This process requires a continuous Steam input, with an equivalent power of 32SU/t.",
    "",
    "If you cannot find a Titanium vein, producing Titanium Dust this way is also a viable path.",
  ],
  "quest.0AFDD068E6975C23.title": "Sulfuric Acid",
  "quest.7AB87161BDCC02A8.quest_desc": [
    "The test tubes in this chapter are optional tasks, provided so you can conveniently view the recipes.",
    "",
    "(&mAlthough they cannot be viewed in the current version; as for why we don't just use fluids, it's because there is a bug in the quest book&r)",
  ],
  "quest.156C13E8839DC9D0.title": "Centrifuging Platinum Group Sludge",
  "quest.0AFDD068E6975C23.quest_subtitle": "The first of GT6's four great acids",
  "quest.69C4C65DF1AC560D.quest_subtitle": "Efficient water electrolysis with Sulfuric Acid and ore as the medium",
  "quest.7BE866156945A526.quest_subtitle": "Bauxite still needs processing?",
  "quest.6A9D035706F5916A.quest_desc": [
    "Electrolyze Rock Salt and Water; byproducts are Chlorine, Hydrogen and Oxygen.",
  ],
  "quest.69C4C65DF1AC560D.title": "Sulfuric Acid Ore Washing",
  "quest.23A67D579CF203EB.quest_subtitle": "Use fluorides to lower the melting point of Alumina",
  "quest.7BE866156945A526.quest_desc": [
    "By washing ore with Sulfuric Acid, you can obtain large amounts of Vitriol of Clay (Aluminium Sulfate) from Purified Bauxite, which yields Alumina after electrolysis.",
    "",
    "If you consider this a shortcut, you can instead follow the upcoming quests and build a complete bauxite processing line properly.",
  ],
  "quest.0AFDD068E6975C23.quest_desc": [
    "1. Use a Roasting Oven to produce Sulfur Dioxide.",
    "",
    "2. In the Mixer, use either [Platinum Dust/Vanadium Pentoxide Dust] as the catalyst and mix Sulfur Dioxide with Air to obtain Sulfur Trioxide.",
    "",
    "3. In the Mixer, mix Sulfur Trioxide with Water to obtain Sulfuric Acid.",
    "",
    "Sulfuric Acid is acidic, so remember to store it in acid-proof tanks.",
  ],
  "quest.2F8FFD7DEA921A51.title": "Nitric Acid Recycling",
  "quest.708E111BC336F1C9.title": "High-Temperature Drying",
  "quest.2F8FFD7DEA921A51.quest_desc": [
    "Feed the Nitrogen Monoxide produced by aqua regia washing, together with Oxygen, into the Mixer to obtain Nitrogen Dioxide.",
    "",
    "Feed Nitrogen Dioxide and Water into the Mixer to obtain Nitric Acid and Nitrogen Monoxide.",
    "",
    "If you have a stable source of Hydrogen Peroxide, you can also oxidize Nitrogen Dioxide with Hydrogen Peroxide to obtain Nitric Acid; this process does not produce Nitrogen Monoxide.",
    "",
    "Whichever way you process Nitrogen Dioxide, the overall Nitrogen in the line is conserved, so there is no need to worry about consumption.",
    "",
    "Oxygen, however, is not; &cit must be supplied from outside&f to keep the aqua regia washing line running normally.",
  ],
  "quest.19A50FC13211C8FC.title": "Aluminium Fluoride",
  "quest.156C13E8839DC9D0.quest_desc": [
    "Feed the Platinum Group Sludge produced by aqua regia washing into a Centrifuge to extract “small amounts” of all six platinum group elements: Platinum, Iridium, Osmium, Ruthenium, Rhodium and Palladium.",
  ],
  "quest.23A67D579CF203EB.title": "Electrolytic Aluminium",
  "task.07521D31A825046A.title": "Tip",
}