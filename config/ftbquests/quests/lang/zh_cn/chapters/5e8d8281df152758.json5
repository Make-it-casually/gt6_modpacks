{
  "quest.0ACAF0EA709D9E0B.title": "稀有气体怎么来",
  "quest.01600AF0D4EC1438.title": "电池盒",
  "quest.0637A970EF2AE227.title": "更高级的电子电路",
  "quest.2A7018846454F62F.quest_desc": [
    "配方里的二氧化硅可用任意石英粉和石英岩粉替代。",
    "",
    "gt6的电子电路并没有套娃式设计，也不像gt5的锁科技锁的那么狠。电子电路分为6个等级并且可以向下兼容。晶体处理器是个例外。",
    "",
    "构成电路板的部件分为基板,电路元件,蚀刻电路和焊料。前三者同样分为6个等级，并遵循木桶原理。第四者则对构成的电路板做出等级上的额外惩罚（铅-2,锡-1,焊锡-0）。",
  ],
  "quest.0C9CFAECE40EEF16.quest_desc": [
    "钻石晶体处理器用量最少，红宝石晶体处理器用量最大。",
    "",
    "恭喜你进入电力时代后期！大机器已解锁！后期电力机器已全部解锁！",
  ],
  "quest.36D33A53FE71B9E0.quest_desc": [
    "可以处理大部分矿物粉。",
  ],
  "quest.1707E46AA4050289.quest_desc": [
    "硅由二氧化硅在坩埚内还原获得。",
    "",
    "二氧化硅在坩埚内可由石英岩和任意石英替代。或者离心熔融玻璃来获得二氧化硅。",
  ],
  "quest.2A7018846454F62F.quest_subtitle": "电子电路的开端",
  "quest.7C1414368D9F6817.title": "结晶器",
  "quest.0637A970EF2AE227.quest_desc": [
    "恭喜你拥有了制作更高级电子电路的资格。",
    "",
    "如果你没有铂处理，就做高级电子电路。",
    "",
    "如果有铂处理产生的大量的铂，就做究极电子电路。",
  ],
  "quest.64A5B458586AEC5E.quest_desc": [
    "低温蒸馏空气获得氮气、氧气、二氧化碳、二氧化硫和稀有气体。",
    "",
    "最重要的用途是获得稀有气体。",
    "",
    "处理空气和下界空气获得微量氦、氖、氩。",
    "",
    "处理末地空气获得微量氪、氙、氡。",
    "",
    "由于后面需要大量的氦和氖，所以请提早挂机。",
  ],
  "quest.1B169D16D60874FA.quest_desc": [
    "手钻可将放置的矿用雷管或火药棒，绑定至远程激活器。",
    "",
    "右键即可点燃所有绑定的炸药。",
  ],
  "quest.607AF01115BBF1D6.quest_desc": [
    "电能有电压和电流的设定，其机制基本和GT5的一样",
    "",
    "电压等级：1-16EU/t为超低压（ULV），16-64为低压（LV），64-256为中压（MV），256-1024为高压（HV），1024-4096为超高压（EV），4096-16384为特高压（IV），16384-65536为剧差压（LuV），65536-262144为零点压（ZPM），262144-1048576为极限压（UV），1048576以上为超极限压（PUV）",
    "",
    "只有电压满足机器电压等级时才会被接收。",
    "",
    "可以由导线传输，会有损耗，注意导线的电压和电流上限。",
    "",
    "未绝缘的导线在有电时碰触会受伤。",
    "",
    "可由电池盒里放入的电池存储。",
    "",
    "极其重要的能源，因为它是第一个可以被大规模储存的能源，而且能转换成几乎所有其他种类的能源！",
  ],
  "quest.00B2D0654ED7F7C8.quest_desc": [
    "通常用于制作蚀刻电路、晶体电路，也能刻蚀砖块起装饰作用。高级蚀刻电路必须要用到该机器。",
  ],
  "quest.414D899FB86A7AA9.quest_desc": [
    "能作电子元件的晶体有三个，单晶硅，单晶锗和单晶红石合金（红硅）。",
    "",
    "需要切成结晶板后再切成小块结晶板后才可制作电子元件。",
    "",
    "三种晶体略有区别：",
    "基础/不错电子元件三种都能做；",
    "进阶电子元件红硅做不了；",
    "高级电子元件只能用红硅做；",
    "高新科技电子元件红硅做不了；",
    "究极电子元件只能用红硅做。",
    "",
    "很神奇吧！",
    "",
    "硅由二氧化硅在坩埚内还原获得。",
    "",
    "二氧化硅在坩埚内可由石英岩和任意石英替代。或者离心熔融玻璃来获得二氧化硅。",
  ],
  "quest.0C9CFAECE40EEF16.title": "晶体处理器",
  "quest.67FB9F1692E2266B.quest_desc": [
    "你或许已经在战利品箱子中找到了一些打火机，如果没有，那就做一个吧。",
    "",
    "比克打火机是唯一可以制作的打火机，需要塑料，同样需要灌装机填充。",
    "",
    "比克打火机用完后会损坏，损坏后可在坩埚或研磨机回收。",
  ],
  "quest.2597D57B88836E35.quest_desc": [
    "通常用于制作蚀刻电路、晶体电路，也能刻蚀砖块起装饰作用。高级蚀刻电路必须要用到该机器。",
  ],
  "quest.663629D0C593DDD6.quest_desc": [
    "4x 及以后规格的线缆必须使用过胶机进行绝缘。",
  ],
  "quest.1BF89AA525338398.quest_desc": [
    "虽然基础电子电路更省材料，但其实和低级电子电路材料区别很小。加上gt6的电子电路向下兼容，推荐直接做低级电子电路。",
  ],
  "quest.79526AE637161944.quest_desc": [
    "自动开关在需要的时候，自动开/关机器，并阻止机器进入待机状态（电力机器待机耗电，如果接了电池盒会把电耗光）。也会自动开启/关闭对机器供能的电动机/引擎/电磁铁。但是它仅能关闭紧贴着的方块。",
    "",
    "如果供能机器与机器不相贴请用活动传感器（就绪）和红石机器开关的组合。",
    "",
    "活动传感器（就绪）在机器正在执行配方或配方输入满足时输出红石信号。",
    "",
    "红石机器开关也可以配合其它传感器使用，如配合能量传感器检测电池盒储量并自动启停发电机。",
    "",
    "再也不用担心燃油引擎空烧了，把第一批电子电路用来做它们，升级你的矿处和工作间吧。",
  ],
  "quest.616B11528D22D5CE.quest_subtitle": "做任意一条线即可",
  "quest.2597D57B88836E35.quest_subtitle": "做任意一条线即可",
  "quest.663629D0C593DDD6.title": "过胶机",
  "quest.0ACAF0EA709D9E0B.quest_desc": [
    "稀有气体分为氦、氖、氩、氪、氙、氡。",
    "",
    "为结晶器获取稀有气体最简单的方式是离心萤石粉获得氦。",
    "",
    "后面还需用到其它稀有气体。",
    "",
    "氖、氪、氙、氡只能通过低温蒸馏塔获得。",
  ],
  "quest.5A28BD71AADF82CE.quest_desc": [
    "比铜更好的电工材料。",
    "",
    "现实中退火铜需要电解精炼，但这里只需将铜加热到2800K。",
    "",
    "如果你想在推进LV主线前获得它，请使用陨钢或铱坩埚。",
    "",
    "&c注意：这个温度接近陨钢坩埚的温度上限和铜的沸点！&r",
  ],
  "quest.58909744EAF18360.quest_desc": [
    "用于罐装各种打火机、激光镭射器、电池和燃料棒/增值棒。",
  ],
  "quest.414D899FB86A7AA9.title": "单晶硅",
  "quest.607AF01115BBF1D6.title": "关于电能",
  "quest.52C2CB0D21AC48F8.quest_desc": [
    "消耗电能同时输出CU（冷能）和HU。",
    "",
    "CU可供给低温蒸馏塔和低温搅拌机，当供给坩埚和模具时可以帮助降温。",
  ],
  "quest.7CE8645C204AB306.quest_subtitle": "电力时代的开始",
  "quest.7CE8645C204AB306.quest_desc": [
    "电力时代也是gt6真正精彩的地方。",
    "",
    "如果你的坩埚线推出了铱坩埚（碳化铌钛在后面才能解锁）并且家里铱多，你可以现在就获取并供给HV发电机。",
    "",
    "&c注意：发电机输出的电流固定为1A，输入转速影响电压。一个满配LV发电机（44EU/t）会烧锡线缆（32EU/t）！&r",
  ],
  "quest.52C2CB0D21AC48F8.title": "半导体制冷器",
  "quest.01600AF0D4EC1438.quest_desc": [
    "电池盒可以放入电池储存EU，也可给电动工具充电。",
    "",
    "电池盒的最大输出电流为电池数量。",
    "",
    "电池等级不能超过电池盒等级。",
    "",
    "LUV及以上的电池盒是无意义的。",
    "",
    "电池盒的输出电压固定，分别为：",
    "ULV：8",
    "LV：32",
    "MV：128",
    "HV：512",
    "EV：2048",
    "IV：8192",
    "LUV：32768",
    "ZPM：131072",
    "UV：524288",
    "PUV1：2087152",
    "",
    "由于这个特性，电池盒可用于整压和限流。",
  ],
  "quest.278585C7C54F4C26.quest_desc": [
    "电解矿粉、电解各种水、生产铝都是它的菜。",
    "",
    "后期可以制作大型多方块结构，拥有无损超频和并行。",
    "",
    "和gt5不同，许多单方块电力机器无需电路板，你离需要电路板的电力机器还远着呢。",
    "",
    "虽然你目前能造出LV和HV的电解器，但HV级别的供电要麻烦很多。",
  ],
  "quest.620F58A0F60FD8A9.quest_desc": [
    "如果你想在推进LV主线前使用HV发电机，那么请使用铱内燃机供能。",
  ],
  "quest.1871FB785B68A306.quest_subtitle": "做任意一条线即可",
  "quest.00B2D0654ED7F7C8.quest_subtitle": "做任意一条线即可",
  "quest.7C1414368D9F6817.quest_desc": [
    "用来结晶硅等晶体的机器。",
    "",
    "也可以结晶红硅、锗晶体、红宝石晶体和各种蓝宝石晶体。",
    "",
    "配方需要稀有气体。",
  ],
  "quest.337DC97B1142DFB7.quest_desc": [
    "最低级的电路主板，也是唯一能不用激光刻蚀机的电路主板。",
  ],
}