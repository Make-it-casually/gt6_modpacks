items {
    #  [default: true]
    B:enableBedrockium=true

    #  [default: true]
    B:enableBlockAnalyzer=true

    #  [default: true]
    B:enableGlove=true

    #  [default: true]
    B:enableGoldenBagOfHolding=true

    #  [default: true]
    B:enableMobJar=true

    #  [default: true]
    B:enableXRayGlasses=true

    invertedtools {

        ethericswordconfig {
            #  [default: true]
            B:Enable=true

            #  [default: true]
            B:Unbreakable=true

            #  [range: 0.0 ~ 20.0, default: 3.0]
            S:magicDamage=3.0

            #  [range: 0.0 ~ 20.0, default: 4.0]
            S:normalDamage=4.0
        }

        destructionpickaxeconfig {
            #  [default: true]
            B:Enable=true

            #  [default: true]
            B:Unbreakable=true

            #  [range: 0.0 ~ 100.0, default: 5.0]
            S:effectiveSpeedModifier=5.0

            # Which blocks the pickaxe is effective against. Format as modid:blockid:meta - if meta is not specified, will use any meta. [default: [minecraft:stone], [minecraft:cobblestone], [minecraft:sandstone], [minecraft:netherrack], [minecraft:hardened_clay], [minecraft:stained_hardened_clay]]
            S:includeEffective <
                minecraft:stone
                minecraft:cobblestone
                minecraft:sandstone
                minecraft:netherrack
                minecraft:hardened_clay
                minecraft:stained_hardened_clay
             >

            #  [range: 0.0 ~ 100.0, default: 0.0625]
            S:ineffectiveSpeedModifier=0.0625

            #  [default: false]
            B:voidMinedBlock=false
        }

        gourmandsaxeconfig {
            #  [default: true]
            B:Enable=true

            #  [default: true]
            B:Unbreakable=true

            #  [range: 0.0 ~ 100.0, default: 15.0]
            S:damageAgainstUndead=15.0

            #  [default: true]
            B:drainHp=true

            #  [range: 0 ~ 20, default: 1]
            I:foodGain=1

            #  [range: 0 ~ 100, default: 3]
            I:maxHeal=3

            #  [range: 0.0 ~ 1.0, default: 0.25]
            S:saturationGain=0.25

            #  [default: true]
            B:spawnParticles=true

            #  [default: true]
            B:useHungerAlways=true

            #  [default: false]
            B:voidMinedBlock=false
        }

        antigravityshovelconfig {
            #  [default: true]
            B:Enable=true

            #  [default: true]
            B:Unbreakable=true

            #  [default: true]
            B:breakFallingAbove=true

            #  [default: true]
            B:voidMinedBlocks=true
        }

        reversinghoeconfig {
            #  [default: true]
            B:Enable=true

            #  [default: true]
            B:Unbreakable=true

            # Which block transformations the reversing hoe will work on. Format as modid:blockid:meta->modid:blockid:meta - if meta of source block is not specified, will work on any meta. If meta of target block is not specified, will transform into meta 0. [default: [minecraft:dirt->minecraft:grass], [minecraft:cobblestone->minecraft:stone], [utilitiesinexcess:cursed_earth->utilitiesinexcess:blessed_earth], [utilitiesinexcess:blessed_earth->utilitiesinexcess:cursed_earth]]
            S:blockTransformations <
                minecraft:dirt->minecraft:grass
                minecraft:cobblestone->minecraft:stone
                utilitiesinexcess:cursed_earth->utilitiesinexcess:blessed_earth
                utilitiesinexcess:blessed_earth->utilitiesinexcess:cursed_earth
             >
        }

        precisionshearsconfig {
            #  [default: true]
            B:Enable=true

            #  [default: true]
            B:Unbreakable=true

            #  [range: 0 ~ 2147483647, default: 20]
            I:cooldown=20

            #  [range: 0.0 ~ 100.0, default: 4.0]
            S:efficiency=4.0

            #  [default: true]
            B:spawnParticles=true

            #  [range: 0 ~ 2147483647, default: 1]
            I:toolLevel=1
        }

    }

    inversion {
        # Set to 0 for unlimited uses [range: 0 ~ 2147483647, default: 256]
        I:awakenedInversionDurability=256

        # Whether or not vanilla splash potions should also be valid if a regular potion of the same type is found. [default: true]
        B:chestSplashPotionsValid=true

        # Amount of unique items in the list the east chest has to contain for the pseudo-reversion ritual [range: 1 ~ 10000, default: 12]
        I:eastChestRequiredItems=12

        # List of valid items the east chest can contain. Must be item ids in the form 'modid:itemname:meta'. Enable splash potions with chestSplashPotionsValid (applies for other chests too). [default: [minecraft:potion:8193], [minecraft:potion:8194], [minecraft:potion:8195], [minecraft:potion:8196], [minecraft:potion:8197], [minecraft:potion:8198], [minecraft:potion:8200], [minecraft:potion:8201], [minecraft:potion:8202], [minecraft:potion:8204], [minecraft:potion:8205], [minecraft:potion:8206], [minecraft:potion:8225], [minecraft:potion:8226], [minecraft:potion:8228], [minecraft:potion:8229], [minecraft:potion:8232], [minecraft:potion:8233], [minecraft:potion:8234], [minecraft:potion:8236], [minecraft:potion:8257], [minecraft:potion:8258], [minecraft:potion:8259], [minecraft:potion:8260], [minecraft:potion:8262], [minecraft:potion:8264], [minecraft:potion:8265], [minecraft:potion:8267], [minecraft:potion:8268], [minecraft:potion:8269], [minecraft:potion:8270]]
        S:eastChestValidItems <
            minecraft:potion:8193
            minecraft:potion:8194
            minecraft:potion:8195
            minecraft:potion:8196
            minecraft:potion:8197
