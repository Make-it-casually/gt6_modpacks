# Configuration file

blocks {
    #  [default: true]
    B:enableBlackoutCurtains=true

    #  [default: true]
    B:enableBlockUpdateDetector=true

    #  [default: true]
    B:enableCollector=true

    #  [default: true]
    B:enableCompressedCobblestone=true

    #  [default: true]
    B:enableCompressedDirt=true

    #  [default: true]
    B:enableCompressedGravel=true

    #  [default: true]
    B:enableCompressedSand=true

    #  [default: true]
    B:enableConveyor=true

    #  [default: true]
    B:enableDecorativeBlocks=true

    #  [default: true]
    B:enableDecorativeGlass=true

    #  [default: true]
    B:enableDrum=true

    # Enable the end of time portal block
    # Can be disabled without disabling the end of time dimension [default: true]
    B:enableEndOfTimePortal=true

    #  [default: true]
    B:enableEnderLocus=true

    #  [default: true]
    B:enableEndspark=true

    #  [default: true]
    B:enableEtherealGlass=true

    #  [default: true]
    B:enableFloatingBlock=true

    #  [default: true]
    B:enableLapisAetherius=true

    #  [default: true]
    B:enableMagicWood=true

    #  [default: true]
    B:enableMarginallyMaximisedChest=true

    #  [default: true]
    B:enableRadicallyReducedChest=true

    #  [default: true]
    B:enableRedstoneClock=true

    #  [default: true]
    B:enableSignificantlyShrunkChest=true

    #  [default: true]
    B:enableTradingPost=true

    #  [default: true]
    B:enableTrashCanEnergy=true

    #  [default: true]
    B:enableTrashCanFluid=true

    #  [default: true]
    B:enableTrashCanItem=true

    #  [default: true]
    B:enableTrueGreenscreen=true

    # Enable the underworld portal block
    # Can be disabled without disabling the underworld dimension [default: true]
    B:enableUnderWorldPortal=true

    # If enabled, inverted block will have a similar X-Ray effect to Extra Utilities' Unstable Block. [default: false]
    B:invertedBlockDoesXRay=false

    spikes {
        #  [default: true]
        B:enableDiamondSpike=true

        #  [default: true]
        B:enableGoldSpike=true

        #  [default: true]
        B:enableIronSpike=true

        #  [default: true]
        B:enableWoodenSpike=true
    }

    ##########################################################################################################
    # cursedearth
    #--------------------------------------------------------------------------------------------------------#
    # Cursed Earth Configuration
    ##########################################################################################################

    cursedearth {
        # Chance that a mob is spawned on a Blessed Earth block on a random tick. [range: 0 ~ 100, default: 40]
        I:blessedEarthSpawnRate=40

        # Chance that a mob is spawned on a Cursed Earth block on a random tick. [range: 0 ~ 100, default: 40]
        I:cursedEarthSpawnRate=40

        # Should blessed and cursed earth spread to nearby grass [default: true]
        B:cursedEarthSpreads=true

        #  [default: true]
        B:enableBlessedEarth=true

        # Should blessed earth burn in darkness like cursed earth burns in the light [default: false]
        B:enableBlessedEarthBurn=false

        #  [default: true]
        B:enableCursedEarth=true

        # Should blessed and cursed earth explode upon contacting each other. cursedEarthSpreads must be true! [default: true]
        B:volatileReaction=true
    }

    mufflers {
        #  [default: true]
        B:enableRainMuffler=true

        #  [default: true]
        B:enableSoundMuffler=true

        # The radius a rain muffler operates in (as a square box) [range: 1 ~ 256, default: 64]
        I:rainMufflerRange=64

        # The radius a sound muffler operates in (as a square box) [range: 1 ~ 64, default: 8]
        I:soundMufflerRange=8

        # The volume reduction of sounds by the sound muffler. 0 = silent, 100 = normal level [range: 0 ~ 100, default: 5]
        I:soundMufflerReduction=5
    }

    chandelier {
        #  [default: true]
        B:Enable=true

        # The radius chandeliers blocks mob spawns (as a square box) [range: 1 ~ 256, default: 16]
        I:Range=16
    }

    gigatorch {
        #  [default: true]
        B:Enable=true

        # The radius a giga torch blocks mob spawns (as a square box) [range: 1 ~ 256, default: 64]
        I:Range=64
    }

    smartpump {
        #  [default: true]
        B:Enable=true

        #  [range: 1 ~ 2147483647, default: 10000]
        I:smartPumpEnergyStorage=10000

        #  [range: 0 ~ 2147483647, default: 100]
        I:smartPumpEnergyUsePerBlock=100

        # The Smart Pump's cooldown (in ticks). [range: 1 ~ 2147483647, default: 200]
        I:smartPumpStallCooldown=200
    }

    voidquarry {
        #  [default: true]
        B:Enable=true

        # Base factor of RF that is used per operation. Is influenced by upgrades & block hardness. [range: 100 ~ 1024000, default: 100]
        I:voidQuarryBaseRFCost=100

        # The amount of blocks the quarry tries to mine per tick, without speed upgrades. [range: 1 ~ 1048, default: 2]
        I:voidQuarryBaseSpeed=2

        # Default amount of blocks the quarry will mine upwards, added to its own y position. [range: 1 ~ 64, default: 5]
        I:voidQuarryDefaultTopPadding=5

        # Energy (RF) capacity of the machine. [range: 256000 ~ 100000000, default: 10000000]
        I:voidQuarryEnergyStorage=10000000

        # The energy multiplier applied when the upgrade is active. [range: 1.0 ~ 64.0, default: 3.0]
        D:voidQuarryFluidPumpEnergyMultiplier=3.0

        # Amount of fluid tanks, with one for each fluid type. [range: 1 ~ 4, default: 2]
        I:voidQuarryFluidTankAmount=2

        # Amount of fluid (in mB) that can be stored per tank. Will have +1000mb of buffer for overflow. [range: 15000 ~ 1023000, default: 127000]
        I:voidQuarryFluidTankStorage=127000

        # The energy multiplier applied when the upgrade is active. [range: 1.0 ~ 128.0, default: 12.0]
        D:voidQuarryFortune1EnergyMultiplier=12.0

        # The energy multiplier applied when the upgrade is active. [range: 1.0 ~ 256.0, default: 40.0]
        D:voidQuarryFortune2EnergyMultiplier=40.0

        # The energy multiplier applied when the upgrade is active. [range: 1.0 ~ 512.0, default: 100.0]
        D:voidQuarryFortune3EnergyMultiplier=100.0

        # Block type to replace mined blocks with if the world hole upgrade isn't present. [default: COBBLE]
        S:voidQuarryReplaceBlock=COBBLE

        # The energy multiplier applied when the upgrade is active. [range: 1.0 ~ 128.0, default: 8.0]
        D:voidQuarrySilkTouchEnergyMultiplier=8.0

        # The energy multiplier applied when the upgrade is active. [range: 1.0 ~ 80.0, default: 8.0]
        D:voidQuarrySpeed1EnergyMultiplier=8.0

        # The multiplier applied to the base mine speed. [range: 1.0 ~ 80.0, default: 2.0]
        D:voidQuarrySpeed1Multiplier=2.0

        # The energy multiplier applied when the upgrade is active. [range: 1.0 ~ 160.0, default: 16.0]
        D:voidQuarrySpeed2EnergyMultiplier=16.0

        # The multiplier applied to the base speed mine speed. [range: 1.0 ~ 160.0, default: 4.0]
        D:voidQuarrySpeed2Multiplier=4.0

        # The energy multiplier applied when the upgrade is active. [range: 1.0 ~ 320.0, default: 32.0]
        D:voidQuarrySpeed3EnergyMultiplier=32.0

        # The multiplier applied to the base speed mine speed. [range: 1.0 ~ 320.0, default: 7.0]
        D:voidQuarrySpeed3Multiplier=7.0

        # The energy multiplier applied when the upgrade is active. [range: 1.0 ~ 64.0, default: 1.2]
        D:voidQuarryWorldHoleEnergyMultiplier=1.2
    }

    purelove {
        #  [default: true]
        B:Enable=true

        # Radius within which animals fall in love [range: 1 ~ 16, default: 8]
        I:"Pure Love range"=8
    }

    pacifistsbench {
        # The Pacifist's Bench cooldown (in ticks). [range: -2147483648 ~ 2147483647, default: 600]
        I:Cooldown=600

        #  [default: true]
        B:Enable=true

        # Enable the Pacifist's Bench to work outside of peaceful mode. [default: false]
        B:pacifistsBenchInNonPeaceful=false
    }

    enderlotus {
        #  [default: true]
        B:Enable=true

        # Chance to drop an extra seed when harvested from a fully grown plant on endspark [range: 0.001 ~ 1.0, default: 0.2]
        D:extraSeedChanceOnEndspark=0.2

        # Chance to drop an extra seed when harvested from a fully grown plant on endstone [range: 0.001 ~ 1.0, default: 0.02]
        D:extraSeedChanceOnEndstone=0.02

        # Average growth ticks to increase growth stage while planted on dirt/grass [range: 1 ~ 1000, default: 100]
        I:growthTicksOnDirt=100

        # Average growth ticks to increase growth stage while planted on endspark [range: 1 ~ 1000, default: 4]
        I:growthTicksOnEndspark=4

        # Average growth ticks to increase growth stage while planted on endstone [range: 1 ~ 1000, default: 25]
        I:growthTicksOnEndstone=25

        # Spawn Ender Lotuses in the End [default: true]
        B:spawnEnderLotusesInEnd=true

        # Ender Lotuses hurt players and mobs when they walk on them [default: true]
        B:thornyLotuses=true
    }

    coloredblocks {
        #  [default: true]
        B:"Enable Colored Blocks"=true

        #  [default: true]
        B:"Enable Paint Roller"=true

        # Register oredictionary entries for colored blocks.
        # Will allow colored blocks to work in recipes, but will also bloat NEI for recipes that people will likely never use... [default: false]
        B:coloredBlockOredict=false

        # Instead of 16 static colors, with this enabled a paint roller will be added which can be used to dye colored blocks
        # Requires EndlessIDs
        # Paint roller and colored blocks must be enabled too [default: true]
        B:enableDying=true

        # WARNING! THIS IS AN ADVANCED CONFIG OPTION!
        # If you don't know what you're doing do not touch.
        # 
        # Add extra blocks to be turned into colored blocks
        # 
        # Format: MODID;BLOCKNAME;BRIGHTNESS;TEXTUREDOMAIN;TEXTURENAME
        #    MODID: Mod ID of the mod that adds the block. NOT DOMAIN. (example: "minecraft")
        #    BLOCKNAME: Name of the block (example: "wool")
        #    BRIGHTNESS: Brightness multiplier (example: "1.5")
        #    TEXTUREDOMAIN: Domain for texture (example: "utilitiesinexcess")
        #    TEXTURENAME: Texture location (example: "textures/blocks/block_update_detector_active.png")
        # 
        # Example: minecraft;double_stone_slab;1;minecraft;textures/blocks/stone_slab_top.png
        # Example: utilitiesinexcess;block_update_detector;1.5;utilitiesinexcess;textures/blocks/block_update_detector_active.png
        #  [default: ]
        S:extraColoredBlocks <
         >
    }

    ##########################################################################################################
    # filingcabinets
    #--------------------------------------------------------------------------------------------------------#
    # Filing Cabinet Configuration
    ##########################################################################################################

    filingcabinets {
        #  [default: true]
        B:Enable=true

        # Amount of additional capacity added per capacity upgrade. [range: 1 ~ 2147483647, default: 4096]
        I:"Upgrade Capacity"=4096

        # Maximum number of capacity upgrades that can be installed in a single filing cabinet.
        # If this is reduced, existing cabinets will retain all of their upgrades beyond the limit. [range: 0 ~ 64, default: 14]
        I:"Upgrade Limit"=14

        ##########################################################################################################
        # basic cabinet settings
        #--------------------------------------------------------------------------------------------------------#
        # Configuration for basic filing cabinets.
        ##########################################################################################################

        "basic cabinet settings" {
            # To disable the cabinet [default: true]
            B:Enable=true

            # The capacity of the cabinet; corresponds to the total number of items that can be held across all slots.
            # WARNING: Reducing this may cause data loss in filing cabinets with more than that many total items! [range: 1 ~ 2147483647, default: 8192]
            I:"Number of Items"=8192

            # The number of slots in the cabinet; corresponds to the number of distinct item types that can be held.
            # WARNING: Reducing this may cause data loss in filing cabinets with more than that many item types!
            # WARNING: Making this too large may make the cabinet GUI difficult to scroll through! [range: 1 ~ 2147483647, default: 256]
            I:"Number of Slots"=256
        }

        ##########################################################################################################
        # advanced cabinet settings
        #--------------------------------------------------------------------------------------------------------#
        # Configuration for advanced filing cabinets.
        ##########################################################################################################

        "advanced cabinet settings" {
            # To disable the cabinet [default: true]
            B:Enable=true

            # The capacity of the cabinet; corresponds to the total number of items that can be held across all slots.
            # WARNING: Reducing this may cause data loss in filing cabinets with more than that many total items! [range: 1 ~ 2147483647, default: 8192]
            I:"Number of Items"=8192

            # The number of slots in the cabinet; corresponds to the number of distinct item types that can be held.
            # WARNING: Reducing this may cause data loss in filing cabinets with more than that many item types!
            # WARNING: Making this too large may make the cabinet GUI difficult to scroll through! [range: 1 ~ 2147483647, default: 512]
            I:"Number of Slots"=512
        }

        ##########################################################################################################
        # elite cabinet settings
        #--------------------------------------------------------------------------------------------------------#
        # Configuration for elite filing cabinets.
        ##########################################################################################################

        "elite cabinet settings" {
            # To disable the cabinet [default: true]
            B:Enable=true

            # The capacity of the cabinet; corresponds to the total number of items that can be held across all slots.
            # WARNING: Reducing this may cause data loss in filing cabinets with more than that many total items! [range: 1 ~ 2147483647, default: 8192]
            I:"Number of Items"=8192

            # The number of slots in the cabinet; corresponds to the number of distinct item types that can be held.
            # WARNING: Reducing this may cause data loss in filing cabinets with more than that many item types!
            # WARNING: Making this too large may make the cabinet GUI difficult to scroll through! [range: 1 ~ 2147483647, default: 128]
            I:"Number of Slots"=128
        }

    }

}


dimensions {

    underworld {
        #  [default: true]
        B:Enable=true

        # The biome to populate the underworld with [range: -2147483648 ~ 2147483647, default: 50]
        I:defaultBiomeId=50

        # Enables increased ore rates and aggressive mob spawning in certain regions [default: true]
        B:enableDifficulty=true

        # Enables the underworld biome [default: true]
        B:enableUnderWorldBiome=true

        # Enables custom ore spawning (typically used by mods to generate their ore) [default: true]
        B:spawnCustomOre=true

        # Enables vanilla ore spawning [default: true]
        B:spawnVanillaOre=true

        # The biome ID for the underworld biome [range: -2147483648 ~ 2147483647, default: 50]
        I:underWorldBiomeId=50

        #  [range: -2147483648 ~ 2147483647, default: 10]
        I:underWorldDimensionId=10
    }

    endoftime {
        #  [default: true]
        B:Enable=true

        # The biome to populate the End of Time with [range: -2147483648 ~ 2147483647, default: 51]
        I:defaultBiomeId=51

        # Enables the End of Time biome [default: true]
        B:enableEndOfTimeBiome=true

        # The biome ID for the End of Time biome [range: -2147483648 ~ 2147483647, default: 51]
        I:endOfTimeBiomeId=51

        #  [range: -2147483648 ~ 2147483647, default: 11]
        I:endOfTimeDimensionId=11

        # Enables rain in the End of Time [default: false]
        B:endOfTimeRain=false

        # Enables natural mob spawning in the End of Time [default: false]
        B:endOfTimeSpawning=false
    }

}


