    architectswands {
        #  [range: -2147483648 ~ 2147483647, default: 9]
        I:architectsWandBuildLimit=9

        #  [range: -2147483648 ~ 2147483647, default: 200]
        I:architectsWandCreativeBuildLimit=200

        # [GT5U] Durability damage dealt to Trowels per block placed by the Architect's Wand. (Set to 0 to disable) [range: -2147483648 ~ 2147483647, default: 100]
        I:damageTrowelWithArchitectsWand=100

        #  [default: true]
        B:enableArchitectsWand=true

        #  [default: true]
        B:enableSuperArchitectsWand=true

        #  [range: -2147483648 ~ 2147483647, default: 49]
        I:superArchitectsWandBuildLimit=49
    }

    wateringcan {
        # If true, the watering can can be used by FakePlayers. [default: false]
        B:"Allow Automated Watering"=false

        # If true, the watering can can be toggled on and off by Crouch + right-clicking. [default: true]
        B:"Allow Watering Can Toggle"=true

        # If true, the player will be slowed down while using the watering can. [default: true]
        B:"Walking Speed Penalty"=true

        tier {
            # Enable or disable the Advanced Watering Can item. [default: true]
            B:"Enable Advanced Watering Can"=true

            # Enable or disable the Basic Watering Can item. [default: true]
            B:"Enable Basic Watering Can"=true

            # Enable or disable the Elite Watering Can item. [default: true]
            B:"Enable Elite Watering Can"=true
        }

        flowering {
            # If true, using the watering can on a flower will duplicate that flower. [default: true]
            B:"Allow Flower Duplication"=true

            # If true, using the watering can on a grass block will spawn random flowers on that block. [default: true]
            B:"Allow Flower Spawning"=true

            # If true, when targeting short blocks (height < 0.85), the flower’s spawn height is lowered by the block’s height to attempt spawning beside the block instead of directly on top. [default: true]
            B:"Spawn Flowers Beside Short Blocks"=true
        }

    }

    chunchunmaru {
        #  [default: true]
        B:Enable=true

        #  [range: 0.0 ~ 200.0, default: 8.0]
        S:creativeDamage=8.0

        #  [default: true]
        B:damageCreativePlayers=true

        #  [range: -2147483648 ~ 2147483647, default: 4096]
        I:durability=4096

        #  [range: 0.0 ~ 200.0, default: 8.0]
        S:normalDamage=8.0

        #  [default: true]
        B:unbreakable=true
    }

    firebattery {
        #  [default: true]
        B:Enable=true

        # RF consumed per burn tick. [range: 1 ~ 2147483647, default: 50]
        I:fireBatteryBurnTime=50

        # Maximum charge rate. [range: 1 ~ 2147483647, default: 1500000]
        I:fireBatteryRFCharge=1500000

        # Maximum RF storage value. [range: 1 ~ 2147483647, default: 1500000]
        I:fireBatteryRFStorage=1500000

        # Maximum RF consumption. [range: 0 ~ 2147483647, default: 15000]
        I:fireBatteryRFUsage=15000
    }

    heavenlyring {
        #  [default: true]
        B:Enable=true

        # With this off, when baubles is loaded players must put heavenly rings in the baubles slot to use them
        # Recommended to keep off for better performance [default: false]
        B:enableInInventoryWithBaubles=false
    }

}


other {
    # 315 is the tinkers material ID Extra Utilities uses for bedrockium and will therefore migrate tools automatically. Must change if both mods are installed! [range: -2147483648 ~ 2147483647, default: 315]
    I:bedrockiumTinkersID=315

    # Enable rendering some UIE baubles on players who have them equipped [default: true]
    B:enableBaubleRenders=true

    # Enables Tinkers' integration for bedrockium, inverted ingots, and magical wood [default: true]
    B:enableTinkersIntegration=true

    # Enable the Extra Utilities to Utilities In Excess world conversion system [default: true]
    B:enableWorldConversion=true

    # 314 is the tinkers material ID Extra Utilities uses for unstable and will therefore migrate tools automatically. Must change if both mods are installed! [range: -2147483648 ~ 2147483647, default: 314]
    I:invertedTinkersID=314

    # 316 is the tinkers material ID Extra Utilities uses for magical wood and will therefore migrate tools automatically. Must change if both mods are installed! [range: -2147483648 ~ 2147483647, default: 316]
    I:magicalWoodTinkersID=316
}


