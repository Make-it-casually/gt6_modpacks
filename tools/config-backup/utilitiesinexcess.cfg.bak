         >

        #  [default: true]
        B:enableInvertedIngot=true

        #  [default: true]
        B:enableReversionSigil=true

        #  [range: -2147483648 ~ 2147483647, default: 300]
        I:invertedIngotImplosionTimer=300

        # What happens when you run out of time while handling Inverted Ingots
        #  IMPLODE: Die, ingots are destroyed
        #  DISAPPEAR: Ingots are destroyed
        #  DECAY: Ingots become Stable Inverted Nuggets
        #  OFF: No timer
        # Possible values: [OFF, IMPLODE, DISAPPEAR, DECAY]
        #  [default: IMPLODE]
        S:invertedIngotMode=IMPLODE

        # Amount of unique items in the list the north chest has to contain for the pseudo-reversion ritual [range: 1 ~ 10000, default: 12]
        I:northChestRequiredItems=12

        # List of valid items the north chest can contain. Must be item ids in the form 'modid:itemname:meta' [default: [minecraft:stone], [minecraft:brick], [minecraft:glass], [minecraft:cooked_fished], [minecraft:hardened_clay], [minecraft:dye:2], [minecraft:coal:1], [minecraft:cooked_beef], [minecraft:iron_ingot], [minecraft:cooked_chicken], [minecraft:gold_ingot], [minecraft:baked_potato], [minecraft:cooked_porkchop], [minecraft:netherbrick]]
